# Copy to .env for local development. Keep real values out of Git and out of chat.
PORT=3000

# Airtable is the system of record. The token needs schema.bases:read,
# data.records:read and data.records:write on this base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Optional local API override for tests; production uses https://api.airtable.com/v0.
# AIRTABLE_API_ROOT=
# Optional tuning (defaults shown): read cache, request spacing, 429 backoff base.
# NMU_AIRTABLE_CACHE_MS=15000
# NMU_AIRTABLE_MIN_INTERVAL_MS=210
# NMU_AIRTABLE_RETRY_BASE_MS=1000

# Google sign-in (default). Only verified Google accounts in this domain can sign in,
# and only if their email is in Airtable Users with Rights = Admin, Manager or Contributor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NMU_ALLOWED_EMAIL_DOMAIN=
# Public origin of the app; Google redirects to $NMU_PUBLIC_URL/auth/google/callback.
NMU_PUBLIC_URL=http://localhost:3000
# 32+ random characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`
NMU_SESSION_SECRET=

# Local development without Google: identify as an Airtable Users email.
# Refused when NODE_ENV=production.
# NMU_AUTH_MODE=dev
# NMU_DEV_USER_EMAIL=
