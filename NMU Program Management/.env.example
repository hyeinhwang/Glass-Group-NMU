# Copy this file to .env and configure the Airtable values before importing.
PORT=3000
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PROJECTS_TABLE=Programs
# JSON mapping from app property to exact Airtable column name:
# {"name":"Program Name","location":"Location","startDate":"Start Date","endDate":"End Date","description":"Description","programType":"Program Type","hostOrganization":"Host Organization"}
AIRTABLE_FIELD_MAPPING={"name":"Program Name","location":"Location","startDate":"Start Date","endDate":"End Date","description":"Description","programType":"Program Type","hostOrganization":"Host Organization"}
