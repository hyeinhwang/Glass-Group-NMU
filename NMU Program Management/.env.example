# Copy to .env and fill in. Keep credentials out of Git and out of chat.
PORT=3000

# Airtable is the app's only data store.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Production sign-in (Railway): NMU_AUTH_MODE=required plus the first administrator.
# NMU_AUTH_MODE=required
# NMU_ADMIN_EMAIL=
# NMU_ADMIN_PASSWORD=          # 12+ characters
# NMU_ADMIN_NAME=
# NMU_SESSION_SECRET=          # long random string that signs session cookies

# Optional tuning
# NMU_AIRTABLE_CACHE_MS=15000  # how long a table is reused before it is re-read
