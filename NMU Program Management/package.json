{
  "name": "nmu-program-management",
  "version": "1.0.0",
  "private": true,
  "description": "NMU swimming program operations and project management MVP",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js",
    "airtable:setup": "node --env-file-if-exists=.env scripts/airtable-setup.js",
    "airtable:seed": "node --env-file-if-exists=.env scripts/airtable-seed.js",
    "dev:mock": "node scripts/dev-mock.js"
  }
}
